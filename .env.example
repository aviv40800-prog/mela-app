# Secret used to sign session cookies (required in production, 32+ chars)
SESSION_SECRET=change-me-to-a-long-random-string-of-32-chars

# Where the SQLite DB and uploaded photos live (defaults to ./data). In production: a mounted volume, e.g. /data
MELA_DATA_DIR=./data

# Admin dashboard (/admin): extra admins (datemela1@gmail.com and 0524080073 are built in).
# Comma-separated; they sign in with the normal code.
MELA_ADMIN_EMAILS=
MELA_ADMIN_PHONES=

# --- Sign-in codes by email (default for new members, free) ---
# "brevo" (free 300/day), "gmail" (Gmail account + App Password, ~500/day), "smtp", "resend" or "console" (dev: code on screen).
# Left empty, it's picked from whichever key below is set. Check what's active at /api/health/email
EMAIL_PROVIDER=
# Brevo → SMTP & API → API keys (starts with xkeysib-). EMAIL_FROM must be a verified sender in Brevo.
BREVO_API_KEY=
EMAIL_FROM="MELA <datemela1@gmail.com>"
GMAIL_USER=datemela1@gmail.com
# Google Account → Security → 2-Step Verification → App passwords (16 letters)
GMAIL_APP_PASSWORD=
# For EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# For EMAIL_PROVIDER=resend (needs a verified domain)
RESEND_API_KEY=

# --- AI-guided sign-up (a short chat instead of the profile form) ---
# Set a Claude API key to turn it on; without one, new members get the regular form.
ANTHROPIC_API_KEY=
# Model for the sign-up chat (default claude-opus-5-5). MELA_AI_ONBOARDING=off disables the chat.
# Cheapest: claude-haiku-5-5 (~1 cent per sign-up). claude-sonnet-5-5 / claude-opus-5-5 cost more.
MELA_AI_MODEL=claude-haiku-5-5
MELA_AI_ONBOARDING=
# New AI sign-up chats per day before new members fall back to the form (0 = no limit)
MELA_AI_DAILY_LIMIT=50

# --- SMS (legacy: members who registered with a phone number) ---
# "console" (dev: code is logged and returned to the client) or "twilio"
SMS_PROVIDER=console
# Demo deploys only: show the code on screen in production (anyone can then log in as anyone)
MELA_SHOW_OTP=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- WhatsApp match trigger ---
# Generic webhook (n8n / Make / Zapier / your backend) called on every mutual match.
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_SECRET=
# Optional: send directly through the WhatsApp Cloud API with an approved template
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=mela_new_match

# --- Freemium ---
# Likes per day for free members (no card). Passes are unlimited. Premium = unlimited.
MELA_FREE_DAILY_LIKES=5
# Max verification codes per source IP per hour (SMS-pumping guard)
MELA_OTP_PER_IP=8

# --- Billing ---
# "mock" activates trials locally. Plug your Israeli PSP (e.g. Stripe / Tranzila / Cardcom) in src/lib/billing.ts
BILLING_PROVIDER=mock
