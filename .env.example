# Secret used to sign session cookies (required in production, 32+ chars)
SESSION_SECRET=change-me-to-a-long-random-string-of-32-chars

# Where the SQLite DB and uploaded photos live (defaults to ./data). In production: a mounted volume, e.g. /data
MELA_DATA_DIR=./data

# Admin dashboard (/admin): comma-separated phone numbers of admins (they sign in with the normal phone code)
MELA_ADMIN_PHONES=050-000-0000

# --- SMS / OTP ---
# "console" (dev: code is logged and returned to the client) or "twilio"
SMS_PROVIDER=console
# Demo deploys only: show the OTP on screen in production (anyone can then log in as any number)
MELA_SHOW_OTP=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- WhatsApp match trigger ---
# Generic webhook (n8n / Make / Zapier / your backend) called on every mutual match.
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_SECRET=
# Optional: send directly through the WhatsApp Cloud API with an approved template
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=mela_new_match

# --- Freemium ---
# Likes per day for free members (no card). Passes are unlimited. Premium = unlimited.
MELA_FREE_DAILY_LIKES=10

# --- Billing ---
# "mock" activates trials locally. Plug your Israeli PSP (e.g. Stripe / Tranzila / Cardcom) in src/lib/billing.ts
BILLING_PROVIDER=mock
